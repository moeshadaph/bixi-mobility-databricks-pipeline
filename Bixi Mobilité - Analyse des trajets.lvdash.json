{
  "datasets": [
    {
      "name": "c60960b1",
      "displayName": "daily_trips_dataset",
      "queryLines": [
        "SELECT trip_date, nb_trips, avg_duration_sec\r\n",
        "FROM bixi_mobility.gold.daily_trips\r\n",
        "ORDER BY trip_date"
      ]
    },
    {
      "name": "3bd14960",
      "displayName": "station_popularity_dataset",
      "queryLines": [
        "SELECT station_name, borough, total_trips\r\n",
        "FROM bixi_mobility.gold.station_popularity\r\n",
        "ORDER BY total_trips DESC\r\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "16f746bc",
      "displayName": "seasonality_dataset",
      "queryLines": [
        "SELECT day_of_week, hour_of_day, nb_trips\r\n",
        "FROM bixi_mobility.gold.seasonality"
      ]
    }
  ],
